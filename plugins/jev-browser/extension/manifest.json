{
  "manifest_version": 3,
  "name": "jev-browser",
  "version": "0.1.0",
  "description": "Lets the jev-browser daemon (Claude Code plugin) drive tabs it opens in this Chrome, over chrome.debugger.",
  "key": "",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "tabs", "storage", "alarms", "webNavigation"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_title": "jev-browser", "default_popup": "popup.html" }
}
